GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Direct native-API endpoints. For host-side dev, port-forward the cluster
# services: kubectl -n demo port-forward svc/prometheus 9090:9090 (etc).
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
GITHUB_TOKEN=
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:3001"]
HOST=0.0.0.0
PORT=8000

# ---- Self-observability (zero-code OTel) -----------------------------------
# Launch with `opentelemetry-instrument uvicorn app.main:app ...` (the Docker
# image already does). The LangChain instrumentor then emits GenAI
# spans/metrics for every Gemini call + LangGraph tool. For host-side dev,
# point OTLP at the cluster's collector: kubectl -n demo port-forward
# svc/otel-collector 4318:4318 (then use the localhost endpoint below).
OTEL_SERVICE_NAME=aiops-agent
OTEL_RESOURCE_ATTRIBUTES=service.namespace=demo,deployment.environment=demo,service.version=v0.0.1,git_repo=tedmax100/o11y-bench,git_version=v0.0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_PYTHON_LOG_CORRELATION=true
